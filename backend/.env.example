# Copy to .env and fill in your key
OPENAI_API_KEY=

# Optional overrides
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Number of knowledge chunks sent to the model per question
TOP_K=5
# Below this similarity (0-1) the agent answers "I don't know" without calling the model
MIN_SIMILARITY=0.25
# Website origin(s) allowed to call the API, comma-separated.
# 5500 = python http.server, 5501 = VS Code Live Server (see .vscode/settings.json).
# On the hosted backend use: https://somawiraga.com,https://www.somawiraga.com
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501
